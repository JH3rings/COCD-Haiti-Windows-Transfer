# Research data and generated artifacts (never upload)
data/
experiments/
checkpoints/
legacy_checkpoints/
results/

# Model weights and prediction payloads
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.npy
*.tif
*.tiff

# Runtime output and caches
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.workbuddy/

# Local environments and editor state
.venv/
venv/
env/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local secrets
.env
.env.*
*.pem
*.key
credentials*.json
secrets*.json

# Curated, compact paper artefacts are versioned.  The rules above continue to
# exclude all raw experiment payloads, checkpoints, logs and tensors.
!experiments/
!experiments/GRSL_complete_paper_package/
!experiments/GRSL_complete_paper_package/**
!results/
!results/tables/
!results/tables/*.csv
!results/tables/*.json

# Keep runtime payloads out even when located below the curated package.
experiments/GRSL_complete_paper_package/**/*.log
experiments/GRSL_complete_paper_package/**/*.npz
experiments/GRSL_complete_paper_package/**/*.npy
experiments/GRSL_complete_paper_package/**/*.pt
experiments/GRSL_complete_paper_package/**/*.pth

# Local bundled runtimes and archives remain on disk, outside Git delivery.
node_modules/
*.zip
*.exe
*.dll
paper_release/local_predictions/*
!paper_release/local_predictions/.gitignore

# Only explicitly curated experiment files are tracked; other local evidence remains retained.
experiments/**
cocd/third_party/landslide_baselines/boehm_landslide_sar_unet/
cocd/third_party/landslide_baselines/dis2_official/
cocd/third_party/landslide_baselines/fc_siam_diff/
